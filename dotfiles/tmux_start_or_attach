#!/usr/bin/env sh

tmux_create_session () {
    # Use -d to allow the rest of the function to run
    tmux -u new-session -d -s persistence -n mon1
    tmux set-option -g mouse off
    tmux new-window -n word_en 'aspell -a'
    tmux new-window -n word_el 'aspell -a -l el'
    tmux new-window -n aux1
    tmux new-window -n prj1
    tmux new-window -d -n prj2
    tmux new-window -d -n prj3
    tmux new-window -d -n prj4
    tmux new-window -d -n aux2
    tmux new-window -d -n aux3
    # -d to detach any other client (which there shouldn't be,
    # since you just created the session).
    tmux -u attach-session -d -t persistence
}

tmux set-option -g mouse off 2>/dev/null
tmux -u attach || tmux_create_session
